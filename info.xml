<?xml version="1.0"?>
<extension key="com.joineryhq.paaosumfields" type="module">
  <file>paaosumfields</file>
  <name>PAAO Summary Fields</name>
  <description>Extends Summary Fields for PAAO</description>
  <license>GPL-3.0</license>
  <maintainer>
    <author>Allen Shaw</author>
    <email>allen@JoineryHQ.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/twomice/com.joineryhq.paaosumfields</url>
    <url desc="Documentation">https://github.com/twomice/com.joineryhq.paaosumfields</url>
    <url desc="Support">https://github.com/twomice/com.joineryhq.paaosumfields/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/gpl-3.0.html</url>
  </urls>
  <releaseDate>2021-04-20</releaseDate>
  <version>1.0.3</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments>Developed by Joinery for Denver DataMan and PAAO</comments>
  <civix>
    <namespace>CRM/Paaosumfields</namespace>
    <format>25.10.2</format>
  </civix>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
